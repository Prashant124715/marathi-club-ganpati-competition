rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          (request.auth.token.role == 'admin') ||
          (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isSubmissionsOpen() {
      return !firestore.exists(/databases/(default)/documents/settings/competition)
        || (
          firestore.get(/databases/(default)/documents/settings/competition).data.submissionsOpen == true
          && (
            !('submissionDeadline' in firestore.get(/databases/(default)/documents/settings/competition).data)
            || firestore.get(/databases/(default)/documents/settings/competition).data.submissionDeadline == null
            || request.time < firestore.get(/databases/(default)/documents/settings/competition).data.submissionDeadline
          )
        );
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function isValidFileSize() {
      // Maximum 50 MB
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // ─── Submissions Media ──────────────────────────────────────────────────
    // Path structure: submissions/{userId}/{fileName}
    //
    // - Public can read submission files (needed for gallery display and preview)
    // - Only authenticated users can upload to their own user directory when submissions are open
    // - Strict validation on MIME type (image, video, pdf) and file size (<= 50MB)
    // - Users cannot overwrite or delete other participants' files
    // - Admins have full management access (delete, overwrite)

    match /submissions/{userId}/{fileName} {
      // Public read for gallery previews
      allow read: if true;

      // Only the authenticated participant can upload to their own directory when open
      allow create: if isOwner(userId)
        && isSubmissionsOpen()
        && isValidContentType()
        && isValidFileSize();

      // Only the owner or an admin can update
      allow update: if (isOwner(userId) && isSubmissionsOpen() && isValidContentType() && isValidFileSize())
        || isAdmin();

      // Only the owner or an admin can delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── Default Deny ───────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
