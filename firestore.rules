rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Returns true if the authenticated user's Firebase Auth email is one of
    // the two hardcoded admin addresses. request.auth.token.email is a
    // server-trusted claim from the ID token — it cannot be forged by clients.
    function isAdminEmailAddress() {
      return isAuthenticated()
        && request.auth.token.email != null
        && (
          request.auth.token.email == '325prashant0009@dbit.in'
          || request.auth.token.email == 'marathiclubdbit26@gmail.com'
        );
    }

    // Validate that data only contains expected fields (prevent extra-field injection)
    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Valid category slugs
    function isValidCategory(cat) {
      return cat in ['home-decor', 'reel-making', 'literature', 'faculty-corner'];
    }

    // Valid submission statuses
    function isValidStatus(status) {
      return status in ['pending', 'approved', 'rejected'];
    }

    // Competition settings guards
    function isSubmissionsOpen() {
      return !exists(/databases/$(database)/documents/settings/competition)
        || (
          get(/databases/$(database)/documents/settings/competition).data.submissionsOpen == true
          && (
            !('submissionDeadline' in get(/databases/$(database)/documents/settings/competition).data)
            || get(/databases/$(database)/documents/settings/competition).data.submissionDeadline == null
            || request.time < get(/databases/$(database)/documents/settings/competition).data.submissionDeadline
          )
        );
    }

    function isVotingOpen() {
      return !exists(/databases/$(database)/documents/settings/competition)
        || (
          get(/databases/$(database)/documents/settings/competition).data.votingOpen == true
          && (
            !('votingDeadline' in get(/databases/$(database)/documents/settings/competition).data)
            || get(/databases/$(database)/documents/settings/competition).data.votingDeadline == null
            || request.time < get(/databases/$(database)/documents/settings/competition).data.votingDeadline
          )
        );
    }

    // ─── SETTINGS ────────────────────────────────────────────────────────────
    // Public read so client UI knows current competition status.
    // Only admins can modify competition controls.

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── USERS ───────────────────────────────────────────────────────────────
    // Users can read their own profile.
    // Users cannot change their own role.
    // Users cannot make themselves admin.
    // Only the two authorized admin email addresses may hold role: "admin".
    // Admins can read and manage all user documents.

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // CREATE: a user may only create their own document.
      // - Non-admin-email users are restricted to role: "participant".
      // - Admin-email users (verified by trusted Auth token) may set role: "admin".
      allow create: if isOwner(uid)
        && hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'emailVerified'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailVerified is bool
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (
          // Admin email addresses may set either role; they will always set "admin"
          (isAdminEmailAddress() && request.resource.data.role in ['admin', 'participant'])
          // All other users must set role: "participant" — no exceptions
          || (!isAdminEmailAddress() && request.resource.data.role == 'participant')
        );

      // UPDATE:
      // - Non-admin users may never change their role field.
      // - Non-admin-email users may never change role to "admin" under any circumstances.
      // - Admins may update any field on any user document.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role  // role is immutable for self
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          // Additionally: non-admin-email users can never have role "admin" written
          && (!isAdminEmailAddress() ? request.resource.data.role != 'admin' : true)
        );

      allow delete: if isAdmin();
    }

    // ─── CATEGORIES ──────────────────────────────────────────────────────────
    // Public read. Only admins can write.

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── SUBMISSIONS ─────────────────────────────────────────────────────────
    // Authenticated users can create their own submissions ONLY when submissions are open.
    // Users cannot create submissions pretending to be another user.
    // Users cannot approve their own submissions.
    // Users cannot change status or voteCount arbitrarily.
    // Only admins can approve/reject/delete submissions.
    // Public users can only read approved submissions.

    match /submissions/{submissionId} {
      // PUBLIC: can only read approved submissions
      // AUTHENTICATED: can also read their own (any status)
      // ADMIN: can read all
      allow read: if resource.data.status == 'approved'
        || (isAuthenticated() && resource.data.participantId == request.auth.uid)
        || isAdmin();

      // Creation is permitted ONLY when submissions are open
      allow create: if isAuthenticated()
        && isSubmissionsOpen()
        && hasOnly(['participantId', 'participantName', 'categoryId', 'title',
                     'description', 'fileUrl', 'fileType', 'status', 'voteCount',
                     'createdAt', 'approvedAt'])
        && request.resource.data.participantId == request.auth.uid
        && request.resource.data.participantName is string
        && request.resource.data.participantName.size() > 0
        && isValidCategory(request.resource.data.categoryId)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 2000
        && request.resource.data.fileUrl is string
        && request.resource.data.fileType in ['image', 'video', 'pdf', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.voteCount == 0
        && request.resource.data.approvedAt == null;

      // UPDATE rules:
      // ADMIN: can update any field (approve, reject, etc.)
      // NON-ADMIN: can ONLY increment voteCount by 1 on approved submission,
      //   when voting is open and user email is verified.
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && isEmailVerified()
          && isVotingOpen()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount'])
          && request.resource.data.voteCount == resource.data.voteCount + 1
        );

      allow delete: if isAdmin();
    }

    // ─── VOTES ───────────────────────────────────────────────────────────────
    // Only authenticated + email-verified users can create votes when voting is open.
    // Vote document ID = {userId}_{categoryId} (deterministic, prevents duplicates).
    // A vote can only be created for the authenticated user (no spoofing).
    // Votes are immutable.

    match /votes/{voteId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && isEmailVerified()
        && isVotingOpen()
        && hasOnly(['id', 'userId', 'userName', 'submissionId', 'categoryId', 'createdAt'])
        && voteId == request.auth.uid + '_' + request.resource.data.categoryId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == voteId
        && request.resource.data.userName is string
        && isValidCategory(request.resource.data.categoryId)
        && request.resource.data.submissionId is string
        && request.resource.data.submissionId.size() > 0
        && exists(/databases/$(database)/documents/submissions/$(request.resource.data.submissionId))
        && get(/databases/$(database)/documents/submissions/$(request.resource.data.submissionId)).data.status == 'approved';

      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── DENY ALL OTHER COLLECTIONS ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
